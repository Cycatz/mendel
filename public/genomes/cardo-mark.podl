# Cardo mark: the Cardo thistle's head reduced to a logo.
# A few broad strands and big scales, every part in
# even rings (whorl) in place of the plant's natural spirals, so it reads as a
# designed, symmetric mark. No leaves, no roots, flat light.
# View it with ?podl=genomes/cardo-mark.podl (add &style=flat for clean colour).
plant "Cardo mark"
axiom A

chromosome 1
  rule BLOOM @5 : Mb/Mb
    Mb = A -> F(0.01) @head(4)   # almost no stem: only the head

chromosome 2
  organ bract @40 : Mt/Mt   # a big flat scale with a pale rim
    Mt = blade(ellipse(), length=0.034 * $SCALE_SIZE, width=0.026 * $SCALE_SIZE, curl=0.04, color=hsl(0.3, 0.3, 0.32), edge=hsl(0.2, 0.25, 0.62))
  organ scales @42 : Ms/Ms   # two even rings of big scales hugging a ball of radius 0.032
    Ms = group(whorl(offset(tilt(bract, deg=-84), y=0.03), n=$SCALES_LOW, tilt=142, twist=$SCALE_TWIST),
               whorl(offset(tilt(bract, deg=-84), y=0.032), n=$SCALES_HIGH, tilt=96, twist=$SCALE_TWIST + 30))
  organ floret @45 : Mf/Mf   # a broad strand curving up and in
    Mf = spike(length=0.065, radius=$STRAND_R, bend=-0.22, color=hsl($PETAL_HUE, $PIGMENT, 0.74))
  organ sweep @46 : Mw/Mw   # a long side strand sweeping up to the height of the middle
    Mw = spike(length=0.095, radius=$STRAND_R, bend=-0.75, color=hsl($PETAL_HUE, $PIGMENT, 0.74))
  organ brush @47 : Mr/Mr   # one ring of side strands sweeping up, one inner ring, one strand in the middle
    Mr = group(whorl(sweep, n=$SIDE, tilt=84), whorl(floret, n=$INNER, tilt=$INNER_TILT, twist=36), whorl(floret, n=1, tilt=0))
  organ head @50 : Mh/Mh   # the scaly ball with the brush on top
    Mh = offset(group(offset(bulb(length=0.064, radius=0.03, color=hsl(0.25, 0.3, 0.3)), y=-0.032),
                      scales, offset(brush, y=0.02)), y=0.032)
  # how many parts the mark has (an inner ring of 1 at tilt 0 hides behind the middle strand)
  num SIDE @60 : Ma/Ma
    Ma = 6
  num INNER @61 : Mc/Mc
    Mc = 3
  num INNER_TILT @62 : Md/Md
    Md = 40
  num STRAND_R @63 : Me/Me   # a strand's radius at its base, m
    Me = 0.026
  num SCALES_LOW @64 : Mg/Mg
    Mg = 6
  num SCALES_HIGH @65 : Mj/Mj
    Mj = 7
  num SCALE_SIZE @66 : Mk/Mk   # big enough to overlap, so the ball reads as scaly, not spotted
    Mk = 1.45
  num SCALE_TWIST @67 : Mq/Mq   # turns the scale rings (180 hides a ring of 1 behind the ball)
    Mq = 0
  num PIGMENT @55 : Mp/Mp
    Mp = 0.8
  num PETAL_HUE @58 : Mu/Mu   # bluer than it looks: flat sunlight warms it to lavender
    Mu = 0.7

chromosome 3
  num TROPISM @10 : Mo/Mo   # straight up
    Mo = 0
  num STEM_W @30 : Mx/Mx
    Mx = 0.018
  num INK @95 : Mi/Mi   # a full outline...
    Mi = 1
  num INK_TINT @97 : Mn/Mn   # ...in the plant's own dark colours
    Mn = 1
  num YELLOW_WASH @98 : My/My
    My = 0
  num SOFT_SHADE @99 : Ms2/Ms2   # flat light
    Ms2 = 1
